# ==============================================================================
# VIJAY VISUALS — ENVIRONMENT VARIABLE TEMPLATE (NO REAL SECRETS IN THIS FILE)
# ==============================================================================
# Configure real secrets in Cloudflare Pages -> Settings -> Environment Variables
# (encrypted Secrets for backend keys, plain/public vars only for VITE_* values).

# ------------------------------------------------------------------------------
# 1. EXISTING PRODUCTION AUTH (SUPABASE AUTH — REQUIRED IN CLOUDFLARE PAGES)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Optional backend-only alias if not reading VITE_SUPABASE_URL in Pages Functions:
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# 2. GEMINI AI ASSISTANT (SERVER-SIDE ONLY — NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional secondary AI provider (off by default)
# ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 3. APPLICATION URL & CUSTOM DOMAIN ROUTING
# ------------------------------------------------------------------------------
APP_URL="https://vijay-visuals-site.pages.dev"
CUSTOM_DOMAIN_CNAME_TARGET="vijay-visuals-site.pages.dev"
# Comma-separated platform hostnames (exempt from tenant domain hijack check)
PLATFORM_HOSTNAMES="vijay-visuals-site.pages.dev,localhost,127.0.0.1"

# ------------------------------------------------------------------------------
# 4. CASHFREE SANDBOX PAYMENTS (SOLE AUTHORIZED GATEWAY)
# ------------------------------------------------------------------------------
# Razorpay is decommissioned. Historical Razorpay ledger columns are preserved
# for old records only; do not configure or reintroduce Razorpay payment flows.
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_WEBHOOK_SECRET=""
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2023-08-01"
# Optional: explicit webhook URL registration; sandbox is the default.
# CASHFREE_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE PAGES CUSTOM DOMAINS / CLOUDFLARE FOR SAAS (OPTIONAL)
# ------------------------------------------------------------------------------
# Phase 1 works up to 100 domains on Cloudflare Pages free tier without paid SaaS.
# Supply token + account ID only if you want automated custom-domain SSL status sync.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PAGES_PROJECT="vijay-visuals-site"
# Phase 2 (100+ domains): Cloudflare for SaaS Custom Hostnames
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=""

# ------------------------------------------------------------------------------
# 6. SCHEDULED RENEWAL / HEALTH CRON SECRET (OPTIONAL)
# ------------------------------------------------------------------------------
# Used by an external cron worker calling POST /api/admin/domains/run-renewal-scan
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 7. OPTIONAL MESSAGING, EMAIL, SMS & SHIPPING CONNECTORS (SETUP REQUIRED)
# ------------------------------------------------------------------------------
# Leave blank if unconfigured; Vijay Visuals never fakes delivery status.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Enquiry notifications require BOTH values, plus the Meta-approved template:
# leave blank to keep delivery honestly marked setup_required (enquiries still save).
WHATSAPP_ENQUIRY_TEMPLATE_NAME=""
WHATSAPP_ENQUIRY_TEMPLATE_LANGUAGE=""
# Business-initiated Cashfree receipts are sent only with an approved template:
# leave blank to keep delivery honestly marked setup_required (no free-form send).
WHATSAPP_PAYMENT_TEMPLATE_NAME=""
WHATSAPP_PAYMENT_TEMPLATE_LANGUAGE=""
# Anonymous StudioLanding enquiries are stored ONLY on this published official
# VIJAY VISUALS desk publication. Never point this at a customer storefront.
PLATFORM_ENQUIRY_TENANT_SLUG=""
# Resend dispatch credential (server-only; never VITE_*). Leave blank to keep
# email delivery honestly marked setup_required.
RESEND_API_KEY=""
# Optional verified sender identity. RESEND_FROM must be on a domain verified in
# Resend; RESEND_VERIFIED_SENDER_DOMAINS is a comma-separated allow-list used by
# the tenant sender guard. Leave blank to keep email delivery setup_required.
RESEND_FROM=""
RESEND_VERIFIED_SENDER_DOMAINS=""
# Optional SendGrid fallback dispatch credential (server-only; never VITE_*)
SENDGRID_API_KEY=""
# Webhook authenticity secrets (server-only; never VITE_*)
RESEND_WEBHOOK_SECRET=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMS_PROVIDER_API_KEY=""
SHIPROCKET_TOKEN=""

# ------------------------------------------------------------------------------
# 8. OPTIONAL DOMAIN REGISTRAR & GOOGLE SEARCH CONSOLE API CONNECTORS
# ------------------------------------------------------------------------------
# Leave blank if unconfigured; never fakes availability, pricing, or GSC analytics.
DOMAIN_REGISTRAR_PROVIDER="" # cloudflare | godaddy | namecheap | resellerclub
DOMAIN_REGISTRAR_API_KEY=""
DOMAIN_REGISTRAR_API_SECRET=""
GSC_OAUTH_CLIENT_ID=""
GSC_OAUTH_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 9. GOOGLE MAPS PLATFORM (RESTRICT HTTP REFERRERS & APIS IN GCP CONSOLE)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
# Optional Mapbox alternative
MAPBOX_ACCESS_TOKEN=""
