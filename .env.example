# ==============================================================================
# VIJAY VISUALS — ENVIRONMENT VARIABLE TEMPLATE (NO REAL SECRETS IN THIS FILE)
# ==============================================================================
# Configure real secrets in Cloudflare Pages -> Settings -> Environment Variables
# (encrypted Secrets for backend keys, plain/public vars only for VITE_* values).

# ------------------------------------------------------------------------------
# 1. EXISTING PRODUCTION AUTH (SUPABASE AUTH — REQUIRED IN CLOUDFLARE PAGES)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
# Optional backend-only alias if not reading VITE_SUPABASE_URL in Pages Functions:
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# ------------------------------------------------------------------------------
# 2. GEMINI AI ASSISTANT (SERVER-SIDE ONLY — NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional secondary AI provider (off by default)
# ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 3. APPLICATION URL & CUSTOM DOMAIN ROUTING
# ------------------------------------------------------------------------------
APP_URL="https://vijay-visuals-site.pages.dev"
CUSTOM_DOMAIN_CNAME_TARGET="vijay-visuals-site.pages.dev"
# Comma-separated platform hostnames (exempt from tenant domain hijack check)
PLATFORM_HOSTNAMES="vijay-visuals-site.pages.dev,localhost,127.0.0.1"

# ------------------------------------------------------------------------------
# 4. RAZORPAY DUAL-FLOW PAYMENTS (START IN TEST MODE rzp_test_*)
# ------------------------------------------------------------------------------
# Set RAZORPAY_LIVE_APPROVED="true" ONLY after owner testing & explicit approval.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_LIVE_APPROVED="false"
# Optional: enable Razorpay Route Linked Account seller settlements when approved
RAZORPAY_ROUTE_ENABLED="false"

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE PAGES CUSTOM DOMAINS / CLOUDFLARE FOR SAAS (OPTIONAL)
# ------------------------------------------------------------------------------
# Phase 1 works up to 100 domains on Cloudflare Pages free tier without paid SaaS.
# Supply token + account ID only if you want automated custom-domain SSL status sync.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_PAGES_PROJECT="vijay-visuals-site"
# Phase 2 (100+ domains): Cloudflare for SaaS Custom Hostnames
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=""

# ------------------------------------------------------------------------------
# 6. SCHEDULED RENEWAL / HEALTH CRON SECRET (OPTIONAL)
# ------------------------------------------------------------------------------
# Used by an external cron worker calling POST /api/admin/domains/run-renewal-scan
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 7. OPTIONAL MESSAGING, EMAIL, SMS & SHIPPING CONNECTORS (SETUP REQUIRED)
# ------------------------------------------------------------------------------
# Leave blank if unconfigured; Vijay Visuals never fakes delivery status.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMS_PROVIDER_API_KEY=""
SHIPROCKET_TOKEN=""

# ------------------------------------------------------------------------------
# 8. OPTIONAL DOMAIN REGISTRAR & GOOGLE SEARCH CONSOLE API CONNECTORS
# ------------------------------------------------------------------------------
# Leave blank if unconfigured; never fakes availability, pricing, or GSC analytics.
DOMAIN_REGISTRAR_PROVIDER="" # cloudflare | godaddy | namecheap | resellerclub
DOMAIN_REGISTRAR_API_KEY=""
DOMAIN_REGISTRAR_API_SECRET=""
GSC_OAUTH_CLIENT_ID=""
GSC_OAUTH_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 9. GOOGLE MAPS PLATFORM (RESTRICT HTTP REFERRERS & APIS IN GCP CONSOLE)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""
VITE_GOOGLE_MAPS_API_KEY=""
# Optional Mapbox alternative
MAPBOX_ACCESS_TOKEN=""
