/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://sdk.cashfree.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://sdk.cashfree.com https://api.cashfree.com https://*.supabase.co wss://*.supabase.co https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com; worker-src 'self' blob:; frame-src 'self' https://sdk.cashfree.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Root images are not content-hashed, so keep a bounded cache with revalidation.
/founder_hero_portrait.png
